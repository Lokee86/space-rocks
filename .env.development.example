# Local development: Rails API, Go game server, diagnostics, and tests.
RAILS_ENV=development
RACK_ENV=development
PORT=3000
SPACE_ROCKS_API_DATABASE_USERNAME=space_rocks_api
SPACE_ROCKS_API_DATABASE_PASSWORD=local_password
SPACE_ROCKS_API_DATABASE_HOST=localhost
SPACE_ROCKS_API_DATABASE_PORT=5432
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
GAME_SERVER_INTERNAL_TOKEN=development-internal-token
API_SERVER_BASE_URL=http://127.0.0.1:3000
PLAYER_DATA_RAILS_BASE_URL=http://127.0.0.1:3000
PLAYER_DATA_RAILS_INTERNAL_TOKEN=development-internal-token
DIAGNOSTIC_AGGREGATOR_ENABLED=true
DIAGNOSTIC_AGGREGATOR_URL=http://127.0.0.1:8080
DIAGNOSTIC_AGGREGATOR_TOKEN=development-diagnostic-token
DIAGNOSTIC_AGGREGATOR_STORAGE_ROOT=data/diagnostic-reports
DIAGNOSTIC_AGGREGATOR_LOG_ROOT=logs/diagnostic-aggregator
BUILD_VERSION=development
ENVIRONMENT=development
LOG_LEVEL=debug
RAILS_LOG_LEVEL=debug
SPACE_ROCKS_WEBSOCKET_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
SPACE_ROCKS_WEBRTC_ADVERTISED_IPS=
SPACE_ROCKS_WEBRTC_UDP_PORT_MIN=
SPACE_ROCKS_WEBRTC_UDP_PORT_MAX=
SPACE_ROCKS_WEBRTC_ADVERTISED_UDP_PORT_MIN=
SPACE_ROCKS_WEBRTC_ADVERTISED_UDP_PORT_MAX=
WEBRTC_ICE_SERVERS=
