---
import { getCollection } from "astro:content";
import ArchiveClientMount from "../../components/ArchiveClientMount";
import PageHead from "../../components/PageHead.astro";
import { buildPageMetadata } from "../../content/pageMetadata";
import "../../components/plasmic/plasmic__default_style.css";
import "../../components/plasmic/space_rocks_devlog/plasmic.css";

function descriptionToPlainText(description: string): string {
	return description.replace(/\*\*/g, "").replace(/\s+/g, " ").trim();
}

const devlogEntries = await getCollection("devlog");
const entries = devlogEntries
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.map((entry) => ({
		id: entry.id,
		title: entry.data.title,
		date: entry.data.date.toISOString().slice(0, 10),
		summary: entry.data.summary,
		href: `/devlog/${entry.id}/`,
	}));

const archiveContent = { entries };
const shareDescription = descriptionToPlainText("All development posts for Space Rocks.");

const metadata = buildPageMetadata({
	site: Astro.site!,
	title: "Space Rocks Devlog Archive",
	description: shareDescription,
	path: "/archive/",
	type: "website",
});
---

<html lang="en">
	<head>
		<PageHead metadata={metadata} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Space Rocks! Devlog RSS"
			href={new URL("/rss.xml", Astro.site)}
		/>
	</head>
	<body>
		<ArchiveClientMount content={archiveContent} client:only="react" />
	</body>
</html>