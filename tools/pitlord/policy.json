{
  "version": 1,
  "includes": [
    "../../.standards/policies/documentation-core.json"
  ],
  "rules": [
    {
      "id": "client-no-server-owned-constants",
      "type": "forbid_content",
      "literal": "Constants.PLAYER_STARTING_LIVES",
      "include_paths": ["client/scripts/*.gd", "client/scripts/**/*.gd"],
      "exclude_paths": ["client/scripts/generated/**"],
      "message": "client scripts must not reference server-owned player starting lives"
    },
    {
      "id": "client-no-server-owned-constants-respawn",
      "type": "forbid_content",
      "literal": "Constants.PLAYER_RESPAWN_DELAY",
      "include_paths": ["client/scripts/*.gd", "client/scripts/**/*.gd"],
      "exclude_paths": ["client/scripts/generated/**"],
      "message": "client scripts must not reference server-owned respawn delay"
    },
    {
      "id": "client-no-server-owned-constants-asteroid",
      "type": "forbid_content",
      "literal": "Constants.ASTEROID_SIZE_SCALE",
      "include_paths": ["client/scripts/*.gd", "client/scripts/**/*.gd"],
      "exclude_paths": ["client/scripts/generated/**"],
      "message": "client scripts must not reference server-owned asteroid scale"
    },
    {
      "id": "no-runtime-context-world-sync-reach-through",
      "type": "forbid_content",
      "regex": "runtime_context\\.world_sync",
      "include_paths": ["client/scripts/*.gd", "client/scripts/**/*.gd"],
      "exclude_paths": ["client/scripts/shell/gameplay_shell_flow.gd"],
      "message": "use the owning composition seam instead of reaching through runtime_context.world_sync"
    },
    {
      "id": "game-server-no-process-global-math-rand",
      "type": "forbid_content",
      "literal": "math/rand",
      "include_paths": [
        "services/game-server/internal/game/*.go",
        "services/game-server/internal/game/**/*.go",
        "services/game-server/internal/devtools/*.go",
        "services/game-server/internal/devtools/**/*.go"
      ],
      "exclude_paths": [
        "services/game-server/internal/game/rng/**",
        "services/game-server/internal/game/*_test.go",
        "services/game-server/internal/game/**/*_test.go",
        "services/game-server/internal/devtools/*_test.go",
        "services/game-server/internal/devtools/**/*_test.go"
      ],
      "message": "authoritative gameplay and devtools production code must not import process-global math/rand; use the seeded rng package instead"
    },
    {
      "id": "client-legacy-auth-token-path-is-read-only",
      "type": "forbid_content",
      "literal": "auth_token.json",
      "include_paths": ["client/scripts/*.gd", "client/scripts/**/*.gd"],
      "exclude_paths": ["client/scripts/auth/auth_token_store.gd"],
      "message": "only the read-only legacy migration reader may reference the plaintext auth-token path"
    },
    {
      "id": "client-no-json-bearer-token-persistence",
      "type": "forbid_content",
      "regex": "JSON\\.stringify\\([^\\n]*token",
      "include_paths": ["client/scripts/auth/*.gd"],
      "message": "bearer credentials must use AuthCredentialStore, not JSON serialization"
    },
    {
      "id": "player-data-no-game-server-internal-imports",
      "type": "forbid_content",
      "regex": "github\\.com/Lokee86/space-rocks/services/game-server/internal/|services/game-server",
      "include_paths": ["services/player-data/*.go", "services/player-data/**/*.go"],
      "message": "player-data must not import or reference game-server implementation packages"
    },
    {
      "id": "player-data-no-api-server-source-reach-through",
      "type": "forbid_content",
      "literal": "services/api-server/app",
      "include_paths": ["services/player-data/*.go", "services/player-data/**/*.go"],
      "message": "player-data must not reference API-server application sources"
    },
    {
      "id": "game-no-debug-prefixed-files",
      "type": "forbid_path",
      "path": "services/game-server/internal/game/debug_*.go",
      "message": "internal/game must not regain debug-prefixed production files"
    },
    {
      "id": "game-no-devtools-imports",
      "type": "forbid_content",
      "literal": "/internal/devtools",
      "include_paths": ["services/game-server/internal/game/*.go"],
      "message": "internal/game must not import internal/devtools"
    },
    {
      "id": "game-no-devtools-stream-state",
      "type": "forbid_content",
      "regex": "activeDebugBulletStreams|DevtoolsContinuousBulletStream|stepDevtoolsContinuousBulletStreams|continuousBulletStreams",
      "include_paths": ["services/game-server/internal/game/*.go"],
      "message": "internal/game must not own devtools continuous-bullet-stream state"
    },
    {
      "id": "game-control-anchor-required",
      "type": "require_path",
      "path": "services/game-server/internal/game/control.go",
      "message": "internal/game/control.go is the authoritative control anchor and must exist"
    },
    {
      "id": "game-focused-control-files-required",
      "type": "require_path",
      "path": "services/game-server/internal/game/control_*.go",
      "message": "internal/game must retain at least one focused control_*.go file"
    },
    {
      "id": "game-no-legacy-export-devtools-files",
      "type": "forbid_path",
      "path": "services/game-server/internal/game/export_devtools*.go",
      "message": "legacy game-side devtools export files must remain absent"
    },
    {
      "id": "game-no-devtools-methods",
      "type": "forbid_content",
      "regex": "func\\s*\\([^)]*\\*Game\\s*\\)\\s*Devtools\\w*\\s*\\(",
      "include_paths": ["services/game-server/internal/game/*.go"],
      "message": "Game must not regain Devtools-prefixed methods"
    },
    {
      "id": "devtools-no-root-game-import",
      "type": "forbid_content",
      "literal": "\"github.com/Lokee86/space-rocks/services/game-server/internal/game\"",
      "include_paths": ["services/game-server/internal/devtools/*.go"],
      "exclude_paths": ["services/game-server/internal/devtools/*_test.go"],
      "message": "devtools production files must use focused game-owned seams instead of importing the root game package"
    },
    {
      "id": "devtools-controller-required",
      "type": "require_path",
      "path": "services/game-server/internal/devtools/controller.go",
      "message": "devtools controller ownership anchor must exist"
    },
    {
      "id": "game-runtime-no-diagnostic-aggregator-dependency",
      "type": "forbid_content",
      "literal": "services/diagnostic-aggregator",
      "include_paths": [
        "services/game-server/internal/*.go",
        "services/game-server/internal/**/*.go",
        "services/player-data/*.go",
        "services/player-data/**/*.go"
      ],
      "message": "game-server internals and player-data must not import diagnostic-aggregator packages; only the game-server composition root may host it"
    },
    {
      "id": "devtools-target-required",
      "type": "require_path",
      "path": "services/game-server/internal/devtools/target.go",
      "message": "devtools target ownership anchor must exist"
    }
  ]
}
