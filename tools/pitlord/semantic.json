  "rules": [
    {
      "id": "game-server-internal-files-require-owner",
      "type": "require_ownership",
      "scope_paths": [
        "services/game-server/internal"
      ],
      "source_kinds": [
        "file"
      ],
      "message": "every game-server internal source file must belong to exactly one declared ownership area"
    },
    {
      "id": "client-script-files-require-owner",
      "type": "require_ownership",
      "scope_paths": [
        "client/scripts"
      ],
      "source_kinds": [
        "file"
      ],
      "message": "every client script must belong to exactly one declared ownership area"
    },
    {
      "id": "service-source-files-require-owner",
      "type": "require_ownership",
      "scope_paths": [
        "services/player-data",
        "services/diagnostic-aggregator",
        "services/api-server"
      ],
      "source_kinds": [
        "file"
      ],
      "message": "standalone service source files must belong to exactly one declared ownership area"
    },
    {
      "id": "shared-go-files-require-owner",
      "type": "require_ownership",
      "scope_paths": [
        "shared/go"
      ],
      "source_kinds": [
        "file"
      ],
      "message": "shared Go source files must belong to the shared-go ownership area"
    },
    {
      "id": "game-core-must-not-depend-on-orchestration",
      "type": "forbid_dependency",
      "from_areas": [
        "game-server-game"
      ],
      "to_areas": [
        "game-server-authclient",
        "game-server-devtools",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-networking",
        "game-server-playerdata",
        "game-server-playerinventory",
        "game-server-rooms",
        "game-server-tooling"
      ],
      "relations": [
        "imports"
      ],
      "message": "authoritative game code must not import orchestration, transport, devtools, or persistence adapters"
    },
    {
      "id": "protocol-must-not-depend-on-networking",
      "type": "forbid_dependency",
      "from_areas": [
        "game-server-protocol"
      ],
      "to_areas": [
        "game-server-networking"
      ],
      "relations": [
        "imports"
      ],
      "message": "protocol packages must remain below networking and must not import networking-owned packages"
    },
    {
      "id": "constants-must-remain-foundational",
      "type": "forbid_dependency",
      "from_areas": [
        "game-server-constants"
      ],
      "to_areas": [
        "game-server-authclient",
        "game-server-devtools",
        "game-server-game",
        "game-server-logging",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-measurement",
        "game-server-networking",
        "game-server-observability",
        "game-server-playerdata",
        "game-server-playerids",
        "game-server-playerinventory",
        "game-server-protocol",
        "game-server-rooms",
        "game-server-tooling"
      ],
      "relations": [
        "imports"
      ],
      "message": "game-server constants must not depend on higher-level runtime packages"
    },
    {
      "id": "shared-go-must-not-depend-on-services",
      "type": "forbid_dependency",
      "from_areas": [
        "shared-go"
      ],
      "to_areas": [
        "game-server-authclient",
        "game-server-constants",
        "game-server-devtools",
        "game-server-game",
        "game-server-logging",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-measurement",
        "game-server-networking",
        "game-server-observability",
        "game-server-playerdata",
        "game-server-playerids",
        "game-server-playerinventory",
        "game-server-protocol",
        "game-server-rooms",
        "game-server-tooling",
        "service-player-data",
        "service-diagnostic-aggregator",
        "service-api-server"
      ],
      "relations": [
        "imports"
      ],
      "message": "shared Go contracts must not import service implementations"
    },
    {
      "id": "player-data-must-not-depend-on-host-services",
      "type": "forbid_dependency",
      "from_areas": [
        "service-player-data"
      ],
      "to_areas": [
        "game-server-authclient",
        "game-server-constants",
        "game-server-devtools",
        "game-server-game",
        "game-server-logging",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-measurement",
        "game-server-networking",
        "game-server-observability",
        "game-server-playerdata",
        "game-server-playerids",
        "game-server-playerinventory",
        "game-server-protocol",
        "game-server-rooms",
        "game-server-tooling",
        "service-diagnostic-aggregator",
        "service-api-server"
      ],
      "relations": [
        "imports"
      ],
      "message": "player-data must remain independent of game-server internals and other service implementations"
    },
    {
      "id": "diagnostic-aggregator-must-not-depend-on-host-services",
      "type": "forbid_dependency",
      "from_areas": [
        "service-diagnostic-aggregator"
      ],
      "to_areas": [
        "game-server-authclient",
        "game-server-constants",
        "game-server-devtools",
        "game-server-game",
        "game-server-logging",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-measurement",
        "game-server-networking",
        "game-server-observability",
        "game-server-playerdata",
        "game-server-playerids",
        "game-server-playerinventory",
        "game-server-protocol",
        "game-server-rooms",
        "game-server-tooling",
        "service-player-data",
        "service-api-server"
      ],
      "relations": [
        "imports"
      ],
      "message": "diagnostic-aggregator must remain independent of its host services"
    },
    {
      "id": "game-server-internals-must-not-host-diagnostic-aggregator",
      "type": "forbid_dependency",
      "from_areas": [
        "game-server-authclient",
        "game-server-constants",
        "game-server-devtools",
        "game-server-game",
        "game-server-logging",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-measurement",
        "game-server-networking",
        "game-server-observability",
        "game-server-playerdata",
        "game-server-playerids",
        "game-server-playerinventory",
        "game-server-protocol",
        "game-server-rooms",
        "game-server-tooling"
      ],
      "to_areas": [
        "service-diagnostic-aggregator"
      ],
      "relations": [
        "imports"
      ],
      "message": "only the game-server composition root may host diagnostic-aggregator"
    },
    {
      "id": "client-runtime-must-not-depend-on-devtools",
      "type": "forbid_dependency",
      "from_areas": [
        "client-auth",
        "client-entities",
        "client-gameplay",
        "client-networking",
        "client-presentation",
        "client-profile",
        "client-protocol",
        "client-session",
        "client-teams",
        "client-world"
      ],
      "to_areas": [
        "client-devtools"
      ],
      "relations": [
        "imports",
        "extends"
      ],
      "message": "client runtime domains must not depend on devtools implementation"
    },
    {
      "id": "game-server-area-imports-must-be-acyclic",
      "type": "forbid_area_cycles",
      "areas": [
        "game-server-authclient",
        "game-server-constants",
        "game-server-devtools",
        "game-server-game",
        "game-server-logging",
        "game-server-matchreporting",
        "game-server-matchresults",
        "game-server-measurement",
        "game-server-networking",
        "game-server-observability",
        "game-server-playerdata",
        "game-server-playerids",
        "game-server-playerinventory",
        "game-server-protocol",
        "game-server-rooms",
        "game-server-tooling"
      ],
      "relations": [
        "imports"
      ],
      "message": "game-server internal ownership areas must not form import cycles"
    }
  ]
}
