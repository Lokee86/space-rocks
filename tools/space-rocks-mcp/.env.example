# Active Info MCP read/search and Hermes access root. Defaults to SPACE_ROCKS_REPO when unset.
WORKSPACE_ROOT=D:\!bin

# Space Rocks-specific root for project integrations and compatibility paths.
SPACE_ROCKS_REPO=D:\!bin\space-rocks

AUTH0_ISSUER=https://YOUR_AUTH0_DOMAIN/
AUTH0_AUDIENCE=https://YOUR_API_IDENTIFIER
RESOURCE_SERVER_URL=https://YOUR_RESOURCE_SERVER_URL/
