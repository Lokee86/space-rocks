{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "tools/list",
  "params": {
    "tools": [
      {
        "name": "hermes_run",
        "description": "Runs the Hermes CLI with arbitrary args and optional stdin.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "stdin": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      {
        "name": "hermes_ping",
        "description": "Confirms the Hermes CLI is available.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "hermes_help",
        "description": "Shows Hermes CLI help.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "hermes_session_status",
        "description": "Shows Hermes status.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "hermes_sessions_list",
        "description": "Lists Hermes sessions.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "hermes_session_send",
        "description": "Sends a prompt into a named Hermes session using session continuation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "session_name": {
              "type": "string",
              "default": "space-rocks-mcp"
            },
            "cwd": {
              "type": "string"
            }
          },
          "required": ["prompt"]
        }
      }
    ]
  }
}