# Hosted multiplayer Docker deployment.
SPACE_ROCKS_IMAGE_TAG=p3-hosted
BUILD_VERSION=p3-hosted
ENVIRONMENT=production
POSTGRES_USER=space_rocks
POSTGRES_PASSWORD=
RAILS_ENV=production
RACK_ENV=production
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
RAILS_LOG_LEVEL=info
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.laughingskull.ca/api/auth/discord/callback
GAME_SERVER_INTERNAL_TOKEN=
DIAGNOSTIC_AGGREGATOR_TOKEN=
LOG_LEVEL=info
SPACE_ROCKS_WEBSOCKET_ALLOWED_ORIGINS=https://space-rocks.laughingskull.ca
SPACE_ROCKS_WEBRTC_ADVERTISED_IPS=
SPACE_ROCKS_WEBRTC_UDP_PORT_MIN=50000
SPACE_ROCKS_WEBRTC_UDP_PORT_MAX=50003
SPACE_ROCKS_WEBRTC_ADVERTISED_UDP_PORT_MIN=
SPACE_ROCKS_WEBRTC_ADVERTISED_UDP_PORT_MAX=
WEBRTC_ICE_SERVERS=
PLAYIT_SECRET_KEY=
